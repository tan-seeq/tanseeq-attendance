# Yarn configuration for improved build reliability
# Helps resolve registry connection issues during deployment

# Network timeout (increase for slow connections)
network-timeout 300000

# Retry failed requests
network-retries 5

# Use fallback registries if primary fails
registry "https://registry.yarnpkg.com"

# Enable offline mirror for reliability
# yarn-offline-mirror "./npm-packages-offline-cache"

# Disable progress bars in CI/CD
disable-progress-bar true

# Enable strict SSL checking
strict-ssl true
